        "    inputs = tokenizer(prompt, return_tensors=\"pt\").to(model.device)  # Use model.device instead of \"cuda\"\n",
        "    output = model.generate(**inputs, max_new_tokens=10)\n",
        "    result = tokenizer.decode(output[0], skip_special_tokens=True)\n",
